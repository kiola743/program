# 이 파일을 복사해서 프로젝트 루트에 .env 로 저장하고 값을 채우세요.
# .env 는 .gitignore 에 포함되어 있어 절대 커밋되지 않습니다.

# 업비트 Open API 키 (https://upbit.com/mypage/open_api_management)
# 백테스트/페이퍼 트레이딩은 키 없이도 동작합니다. 실주문(live)에만 필요합니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 디스코드 웹훅 URL (채널 설정 → 연동 → 웹훅 만들기)
# 비워두면 알림이 콘솔 출력으로 대체됩니다.
DISCORD_WEBHOOK_URL=

# (추후) 한국투자증권 KIS Developers
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
